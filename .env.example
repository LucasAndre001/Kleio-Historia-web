# ===================================================================
#  Kleio História — variáveis de ambiente (EXEMPLO)
#
#  1. Copie este arquivo:   cp .env.example .env     (Windows: copy .env.example .env)
#  2. Ajuste os valores se quiser.
#  3. O arquivo .env NÃO vai para o GitHub (está no .gitignore).
#
#  Estes valores são apenas para uso LOCAL, em demonstração e estudo.
# ===================================================================

# --- PostgreSQL ---
POSTGRES_DB=kleio_historia
POSTGRES_USER=kleio
POSTGRES_PASSWORD=troque_esta_senha_local

# --- JWT (mínimo de 32 caracteres; use qualquer texto longo e aleatório) ---
JWT_CHAVE=troque-por-uma-frase-longa-e-aleatoria-com-32+-caracteres
JWT_EXPIRACAO_MINUTOS=120

# --- Administrador de demonstração (criado na primeira inicialização) ---
# Senha: mínimo 8 caracteres, com maiúscula, minúscula e número.
ADMIN_NOME=Professor Administrador
ADMIN_EMAIL=professor@kleio.local
ADMIN_SENHA=Kleio2026!

# --- Dados demonstrativos (4 artigos de exemplo na primeira inicialização) ---
SEMEAR_DADOS_DEMO=true

# --- Portas no seu computador (mude se alguma já estiver em uso) ---
FRONTEND_PORTA_HOST=4200
API_PORTA_HOST=5080
POSTGRES_PORTA_HOST=5433
